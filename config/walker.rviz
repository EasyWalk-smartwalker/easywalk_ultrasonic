Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Axes: true
      Show Names: false
      Frame Timeout: 15

    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description

    - Class: rviz_default_plugins/Range
      Name: Range L30
      Enabled: true
      Topic:
        Value: /walker/range/l30
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Queue Size: 10
      Alpha: 0.4
      Color: 255; 0; 0
      Buffer Length: 1

    - Class: rviz_default_plugins/Range
      Name: Range L15
      Enabled: true
      Topic:
        Value: /walker/range/l15
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Queue Size: 10
      Alpha: 0.4
      Color: 255; 128; 0
      Buffer Length: 1

    - Class: rviz_default_plugins/Range
      Name: Range CTR
      Enabled: true
      Topic:
        Value: /walker/range/ctr
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Queue Size: 10
      Alpha: 0.4
      Color: 255; 255; 0
      Buffer Length: 1

    - Class: rviz_default_plugins/Range
      Name: Range R15
      Enabled: true
      Topic:
        Value: /walker/range/r15
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Queue Size: 10
      Alpha: 0.4
      Color: 0; 255; 255
      Buffer Length: 1

    - Class: rviz_default_plugins/Range
      Name: Range R30
      Enabled: true
      Topic:
        Value: /walker/range/r30
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Queue Size: 10
      Alpha: 0.4
      Color: 0; 128; 255
      Buffer Length: 1

    - Class: rviz_default_plugins/Range
      Name: Range BOT
      Enabled: true
      Topic:
        Value: /walker/range/bot
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Queue Size: 10
      Alpha: 0.4
      Color: 200; 0; 255
      Buffer Length: 1

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30

  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera

  Value: true

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.5
      Yaw: 0.785
      Target Frame: base_link
